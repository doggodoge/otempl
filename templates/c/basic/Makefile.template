CC ?= cc
CFLAGS ?= -std=c17 -Wall -Wextra -Wpedantic
TARGET := {{name}}
SOURCE := alignment.c arena.c files.c string_view.c main.c

.PHONY: build run release debug install clean

build:
	$(CC) $(CFLAGS) $(SOURCE) -o $(TARGET)

run: build
	./$(TARGET)

release:
	$(CC) $(CFLAGS) -O2 $(SOURCE) -o $(TARGET)

debug:
	$(CC) $(CFLAGS) -O0 -g $(SOURCE) -o $(TARGET)

install: release
	mkdir -p ~/.local/bin
	cp $(TARGET) ~/.local/bin/$(TARGET)
	chmod +x ~/.local/bin/$(TARGET)

clean:
	rm -rf $(TARGET) $(TARGET).dSYM/
