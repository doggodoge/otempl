#include "raylib.h"
#include "base.h"

// Unity build: compile only main.c; include project implementations here.
#include "alignment.c"
#include "arena.c"
#include "static_arena.c"
#include "string_view.c"
#include "files.c"

i32 main(void) {
    InitWindow(800, 450, "{{name}}");
    SetTargetFPS(60);

    while (!WindowShouldClose()) {
        BeginDrawing();
        ClearBackground(RAYWHITE);
        DrawText("Congrats! You created your first window!", 190, 200, 20, LIGHTGRAY);
        EndDrawing();
    }

    CloseWindow();
    return 0;
}
